#!/bin/sh
# Runs as root after the package is installed. The daemon runs per user, so
# register it for whoever is logged in at the console, as that user. It stays
# idle until the computer is paired (`cww login` or the `cww` terminal UI).
# Never fails the installation.
user=$(stat -f %Su /dev/console 2>/dev/null)
case "$user" in
  ""|root|loginwindow|_mbsetupuser)
    echo 'Open Chat with Work in Applications after login, or run: cww daemon install'
    exit 0 ;;
esac
uid=$(id -u "$user" 2>/dev/null) || exit 0
if ! launchctl asuser "$uid" sudo -H -u "$user" /usr/local/bin/cww daemon install; then
  echo 'The agent could not start. Open Chat with Work in Applications, or run as your own user: cww daemon install'
fi
exit 0
