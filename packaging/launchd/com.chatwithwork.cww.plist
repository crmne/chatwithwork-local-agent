<?xml version="1.0" encoding="UTF-8"?>
<!--
  LaunchAgent for the Chat with Work Local Agent (Homebrew on Apple silicon).
  `cww daemon install` writes this file to ~/Library/LaunchAgents with the
  right binary path for your machine and loads it; copy it by hand only if
  you know you need to.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.chatwithwork.cww</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/cww</string>
    <string>daemon</string>
    <string>run</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ProcessType</key>
  <string>Background</string>
  <key>ThrottleInterval</key>
  <integer>10</integer>
</dict>
</plist>
