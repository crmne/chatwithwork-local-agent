{
    "version": "@VERSION@",
    "description": "Chat with Work: desktop app, terminal interface and local background agent.",
    "homepage": "https://github.com/crmne/chatwithwork-local-agent",
    "license": "MIT|Apache-2.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/crmne/chatwithwork-local-agent/releases/download/v@VERSION@/cww-v@VERSION@-x86_64-pc-windows-msvc.zip",
            "hash": "@WINDOWS_X64_ZIP_SHA256@",
            "extract_dir": "cww-v@VERSION@-x86_64-pc-windows-msvc"
        },
        "arm64": {
            "url": "https://github.com/crmne/chatwithwork-local-agent/releases/download/v@VERSION@/cww-v@VERSION@-aarch64-pc-windows-msvc.zip",
            "hash": "@WINDOWS_ARM64_ZIP_SHA256@",
            "extract_dir": "cww-v@VERSION@-aarch64-pc-windows-msvc"
        }
    },
    "bin": "cww.exe",
    "notes": [
        "Open Chat with Work from the Start menu, or run cww for the terminal interface.",
        "The agent starts now and at every logon for per-user installs. If startup failed, run: cww daemon install",
        "Check the agent: cww status. Nothing is shared until you pair and choose a folder."
    ],
    "pre_uninstall": "if (Test-Path \"$dir\\cww.exe\") { & \"$dir\\cww.exe\" daemon uninstall | Out-Null }",
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/crmne/chatwithwork-local-agent/releases/download/v$version/cww-v$version-x86_64-pc-windows-msvc.zip",
                "extract_dir": "cww-v$version-x86_64-pc-windows-msvc"
            },
            "arm64": {
                "url": "https://github.com/crmne/chatwithwork-local-agent/releases/download/v$version/cww-v$version-aarch64-pc-windows-msvc.zip",
                "extract_dir": "cww-v$version-aarch64-pc-windows-msvc"
            }
        },
        "hash": {
            "url": "$baseurl/checksums.txt"
        }
    },
    "shortcuts": [
        [
            "cww-app.exe",
            "Chat with Work"
        ],
        [
            "cww.exe",
            "Chat with Work (Terminal)"
        ]
    ],
    "post_install": [
        "if ($global) {",
        "    warn \"Open Chat with Work as your own user, or run: cww daemon install\"",
        "} else {",
        "    & \"$dir\\cww.exe\" daemon install",
        "    if ($LASTEXITCODE -ne 0) { warn \"Agent startup failed. Open Chat with Work, or run: cww daemon install\" }",
        "}"
    ]
}
